          "app_items": [
            {
              "html_code": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>タイピング学習サイト</title>\n  <style>\n    /* ==========================================================================\n       1. 基本スタイル設定（文字・ボタンをより大きく見やすく改修）\n       ========================================================================== */\n    :root {\n      --primary-dark: #1e3a8a;   /* 濃い青 */\n      --primary-main: #2563eb;   /* メインの青 */\n      --primary-light: #eff6ff;  /* 薄い青背景 */\n      --accent-color: #f59e0b;   /* アクセントのオレンジ */\n      --accent-green: #059669;   /* 正解・成功の緑 */\n      --text-main: #0f172a;      /* 文字色（濃いネイビー） */\n      --text-muted: #475569;     /* 補助文字色 */\n      --white: #ffffff;\n      --shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n      --radius: 20px;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: \"Helvetica Neue\", Arial, \"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", Meiryo, sans-serif;\n      background-color: var(--primary-light);\n      color: var(--text-main);\n      font-size: 18px; /* 全体の基本文字サイズを拡大 */\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      overflow-x: hidden;\n    }\n\n    /* ==========================================================================\n       2. ヘッダーエリア\n       ========================================================================== */\n    header {\n      width: 100%;\n      background: linear-gradient(135deg, var(--primary-dark), var(--primary-main));\n      color: var(--white);\n      padding: 20px;\n      text-align: center;\n      box-shadow: var(--shadow);\n      z-index: 10;\n    }\n\n    header h1 {\n      font-size: clamp(1.8rem, 5vw, 2.8rem); /* タイトルを特大化 */\n      letter-spacing: 0.05em;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 12px;\n    }\n\n    /* ==========================================================================\n       3. メインコンテナ（スライド表示エリア）\n       ========================================================================== */\n    main {\n      flex: 1;\n      width: 100%;\n      max-width: 1150px;\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      align-items: center;\n    }\n\n    .slide-container {\n      background: var(--white);\n      width: 100%;\n      min-height: 580px;\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      padding: 35px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      position: relative;\n    }\n\n    .slide {\n      display: none;\n      animation: fadeIn 0.3s ease-in-out;\n      width: 100%;\n      height: 100%;\n    }\n\n    .slide.active {\n      display: flex;\n      flex-direction: column;\n      gap: 22px;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(8px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    /* スライドタイトル */\n    .slide-title {\n      font-size: clamp(1.6rem, 4vw, 2.2rem); /* 見出し拡大 */\n      color: var(--primary-dark);\n      border-bottom: 4px solid var(--primary-main);\n      padding-bottom: 10px;\n      display: flex;\n      align-items: center;\n      gap: 15px;\n      flex-wrap: wrap;\n    }\n\n    .badge {\n      background-color: var(--primary-main);\n      color: var(--white);\n      font-size: 1.1rem;\n      padding: 6px 16px;\n      border-radius: 30px;\n      font-weight: bold;\n    }\n\n    /* 内容コンテンツのカード配置 */\n    .content-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n      gap: 20px;\n      margin-top: 10px;\n    }\n\n    .card {\n      background-color: #f8fafc;\n      border: 3px solid #e2e8f0;\n      border-radius: 16px;\n      padding: 24px;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 14px;\n    }\n\n    .card-icon {\n      font-size: 3.8rem; /* アイコン特大化 */\n    }\n\n    .card h3 {\n      color: var(--primary-dark);\n      font-size: 1.4rem; /* カード見出し拡大 */\n    }\n\n    .card p {\n      font-size: 1.15rem; /* 本文文字拡大 */\n      color: var(--text-main);\n      line-height: 1.6;\n    }\n\n    /* ==========================================================================\n       4. ナビゲーションバー（ボタン拡大）\n       ========================================================================== */\n    .controls {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 25px;\n      width: 100%;\n      gap: 15px;\n    }\n\n    /* 押しやすい超大型ボタン */\n    .btn {\n      background-color: var(--primary-main);\n      color: var(--white);\n      border: none;\n      padding: 16px 36px;\n      font-size: 1.3rem; /* ボタン文字サイズUP */\n      font-weight: bold;\n      border-radius: 50px;\n      cursor: pointer;\n      box-shadow: 0 6px 12px rgba(37, 99, 235, 0.25);\n      transition: all 0.2s ease;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 60px; /* タップ領域の拡大 */\n      user-select: none;\n    }\n\n    .btn:active {\n      transform: scale(0.96);\n    }\n\n    .btn:hover {\n      background-color: var(--primary-dark);\n    }\n\n    .btn:disabled {\n      background-color: #cbd5e1;\n      color: #94a3b8;\n      cursor: not-allowed;\n      box-shadow: none;\n      transform: none;\n    }\n\n    .btn-accent {\n      background-color: var(--accent-color);\n      color: #000;\n    }\n    .btn-accent:hover {\n      background-color: #d97706;\n      color: var(--white);\n    }\n\n    .progress-bar-container {\n      flex: 1;\n      background-color: #e2e8f0;\n      height: 16px;\n      border-radius: 8px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    .progress-bar {\n      height: 100%;\n      background-color: var(--primary-main);\n      width: 0%;\n      transition: width 0.3s ease;\n    }\n\n    .slide-counter {\n      font-weight: bold;\n      color: var(--primary-dark);\n      font-size: 1.2rem;\n      min-width: 80px;\n      text-align: center;\n    }\n\n    /* ==========================================================================\n       5. インタラクティブクイズ（複数問題対応＆サイズ強化）\n       ========================================================================== */\n    .quiz-card {\n      background: #f8fafc;\n      border: 3px solid #cbd5e1;\n      border-radius: 16px;\n      padding: 25px;\n      display: flex;\n      flex-direction: column;\n      gap: 15px;\n    }\n\n    .quiz-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-weight: bold;\n      color: var(--primary-dark);\n      font-size: 1.2rem;\n    }\n\n    .quiz-question {\n      font-size: 1.35rem;\n      font-weight: bold;\n      color: var(--text-main);\n      line-height: 1.5;\n    }\n\n    .quiz-options {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      width: 100%;\n    }\n\n    /* クイズ専用の大型選択肢ボタン */\n    .quiz-option-btn {\n      background: var(--white);\n      border: 3px solid #94a3b8;\n      padding: 16px 20px;\n      border-radius: 12px;\n      font-size: 1.25rem;\n      font-weight: bold;\n      color: var(--text-main);\n      cursor: pointer;\n      text-align: left;\n      transition: all 0.2s;\n      min-height: 60px;\n    }\n\n    .quiz-option-btn:hover {\n      border-color: var(--primary-main);\n      background-color: var(--primary-light);\n    }\n\n    .quiz-feedback {\n      padding: 18px;\n      border-radius: 12px;\n      font-size: 1.2rem;\n      font-weight: bold;\n      text-align: center;\n      display: none;\n      line-height: 1.6;\n    }\n\n    .quiz-feedback.correct {\n      background-color: #d1fae5;\n      color: #065f46;\n      border: 2px solid #10b981;\n    }\n\n    .quiz-feedback.incorrect {\n      background-color: #fee2e2;\n      color: #991b1b;\n      border: 2px solid #ef4444;\n    }\n\n    .quiz-next-btn {\n      align-self: center;\n      margin-top: 10px;\n      display: none;\n    }\n\n    /* ==========================================================================\n       6. 寿司打対決（最終スライド）専用スタイル\n       ========================================================================== */\n    .sushida-box {\n      background: linear-gradient(135deg, #fef3c7, #fffbe3);\n      border: 4px solid #f59e0b;\n      border-radius: 20px;\n      padding: 30px;\n      text-align: center;\n      box-shadow: var(--shadow);\n    }\n\n    .target-badge {\n      display: inline-block;\n      background: #ef4444;\n      color: white;\n      padding: 8px 24px;\n      border-radius: 30px;\n      font-weight: bold;\n      font-size: 1.3rem;\n      margin-bottom: 15px;\n    }\n\n    .sushida-link-btn {\n      display: inline-block;\n      background-color: #dc2626;\n      color: white;\n      text-decoration: none;\n      font-size: 1.7rem; /* アクションボタン巨大化 */\n      font-weight: bold;\n      padding: 20px 48px;\n      border-radius: 50px;\n      box-shadow: 0 8px 0 #991b1b;\n      transition: all 0.2s;\n      margin-top: 20px;\n    }\n\n    .sushida-link-btn:hover {\n      transform: translateY(4px);\n      box-shadow: 0 4px 0 #991b1b;\n      background-color: #b91c1c;\n    }\n\n    /* ==========================================================================\n       7. 著作権表示 (右下に固定: fixed)\n       ========================================================================== */\n    footer.copyright {\n      position: fixed;\n      bottom: 12px;\n      right: 18px;\n      font-size: 1rem; /* スマホ・タブレットでも読みやすいサイズ */\n      font-weight: bold;\n      color: #334155;\n      background: rgba(255, 255, 255, 0.9);\n      padding: 6px 14px;\n      border-radius: 14px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n      backdrop-filter: blur(4px);\n      z-index: 999;\n      border: 1px solid #cbd5e1;\n    }\n\n    /* レスポンシブ対応 (スマホ・タブレット調整) */\n    @media (max-width: 768px) {\n      body {\n        font-size: 16px;\n      }\n      .slide-container {\n        padding: 20px;\n        min-height: 520px;\n      }\n      .controls {\n        flex-wrap: wrap;\n      }\n      .btn {\n        padding: 14px 24px;\n        font-size: 1.1rem;\n        flex: 1;\n      }\n      .progress-bar-container {\n        order: -1;\n        width: 100%;\n        flex: none;\n      }\n      footer.copyright {\n        font-size: 0.85rem;\n        bottom: 6px;\n        right: 10px;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- ヘッダータイトル -->\n  <header>\n    <h1>⌨️ タイピング学習サイト</h1>\n  </header>\n\n  <!-- メインコンテンツ領域 (スライド形式) -->\n  <main>\n    <div class=\"slide-container\">\n      \n      <!-- スライド1: 【身近な例】 -->\n      <div class=\"slide active\">\n        <h2 class=\"slide-title\"><span class=\"badge\">1. 身近な例</span>日常でのタイピング体験</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\">\n            <div class=\"card-icon\">📱</div>\n            <h3>スマホとパソコンの違い</h3>\n            <p>スマホのフリック入力も速いですが、長い文章やレポート作成ではキーボードが圧倒的に便利です！</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">💬</div>\n            <h3>オンラインチャットやゲーム</h3>\n            <p>友達との会話やゲーム内のチャットも、タイピングが速いと思い通りのコミュニケーションが取れます。</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">📝</div>\n            <h3>授業のノート・メモ作成</h3>\n            <p>手元を見ずに打てると、先生の話を聞きながら素早くアイデアを文字に残せます。</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド2: 【なぜ学ぶか】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">2. なぜ学ぶか</span>タイピングを学ぶ必要性</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\">\n            <div class=\"card-icon\">⚡</div>\n            <h3>作業時間が格段に短くなる</h3>\n            <p>キーを探す時間がなくなれば、宿題や課題作成にかかる時間が半分以下になります！</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">🧠</div>\n            <h3>考えをスムーズにアウトプット</h3>\n            <p>打ち方を考えずに済むので、自分の「考え」や「表現」に全集中できます。</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">💼</div>\n            <h3>一生役立つポータブルスキル</h3>\n            <p>進学や社会人になっても毎日使うスキル。中学生のうちにマスターすると一生得をします！</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド3: 【今日の学習目標】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">3. 学習目標</span>今日のめあて</h2>\n        <div style=\"background-color: var(--primary-light); border-left: 8px solid var(--primary-main); padding: 30px; border-radius: 12px; margin-top: 15px;\">\n          <h3 style=\"color: var(--primary-dark); font-size: 1.8rem; margin-bottom: 18px;\">🎯 今日のゴール</h3>\n          <p style=\"font-size: 1.35rem; line-height: 1.9; color: var(--text-main);\">\n            1. 基本の<b>「ホームポジション」</b>の位置を完璧に覚える！<br>\n            2. 手元を見ずに画面を見て入力する意識を持つ！<br>\n            3. <b>「寿司打（お手軽3,000円コース）」</b>で目標スコア達成を目指す！\n          </p>\n        </div>\n      </div>\n\n      <!-- スライド4: 【仕組み】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">4. 仕組み</span>基本の「ホームポジション」</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\" style=\"grid-column: span 2;\">\n            <div class=\"card-icon\">🖐️</div>\n            <h3>人差し指の「定位置」を決める</h3>\n            <p style=\"font-size: 1.25rem; text-align: left;\">\n              ・左手の人差し指は <b>「 F 」</b>、右手の人差し指は <b>「 J 」</b> に置きます。<br>\n              ・<b>F</b> と <b>J</b> のキーには小さな<b>「突起（ぽっち）」</b>がついているので手触りで確認できます！<br>\n              ・1文字打ったら、必ずこのホームポジションに指を戻すのが最大のコツです。\n            </p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">👀</div>\n            <h3>画面を見る習慣をつける</h3>\n            <p>手元を見ずに画面を見る「タッチタイピング」を目標に練習しましょう。</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド5: 【メリット・デメリット】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">5. 比較</span>タッチタイピング vs 自己流入力</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\" style=\"border-top: 6px solid var(--accent-green);\">\n            <div class=\"card-icon\">⭕</div>\n            <h3>タッチタイピング（正しい打ち方）</h3>\n            <p style=\"text-align: left;\">\n              ✅ 入力速度がどんどん速くなる<br>\n              ✅ 画面だけ見るので目が疲れにくい<br>\n              ✅ 打ち間違いにすぐ気づくことができる\n            </p>\n          </div>\n          <div class=\"card\" style=\"border-top: 6px solid #ef4444;\">\n            <div class=\"card-icon\">❌</div>\n            <h3>自己流（人差し指だけ・手元見る）</h3>\n            <p style=\"text-align: left;\">\n              ❌ スピードの伸びに限界が来る<br>\n              ❌ 手元と画面を往復するため首や目が疲れる<br>\n              ❌ ミス入力に気づきにくい\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド6: 【歴史・背景】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">6. 歴史</span>キー配列（QWERTY）の秘密</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\">\n            <div class=\"card-icon\">📜</div>\n            <h3>QWERTY（クワーティ）配列</h3>\n            <p>キーボードの左上の並びが「Q, W, E, R, T, Y」となっている理由を知っていますか？</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">🖨️</div>\n            <h3>タイプライター時代の工夫</h3>\n            <p>昔の機械式タイプライターで、速く打ちすぎて文字のレバーが絡まるのを防ぐために、あえて打ちにくい配置にしたのが始まりと言われています。</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド7: 【社会での使われ方】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">7. 社会での活用</span>実際の仕事での事例</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\">\n            <div class=\"card-icon\">💻</div>\n            <h3>ITエンジニア・プログラマー</h3>\n            <p>頭の中のアイデアやプログラムコードを素早く正確に入力するために必須。</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">📰</div>\n            <h3>新聞記者・ライター</h3>\n            <p>インタビューを聞きながら、リアルタイムで正確なメモや原稿を作成します。</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">🏢</div>\n            <h3>一般的なオフィスワーク</h3>\n            <p>メール送受信、書類作成、データ入力など、あらゆる仕事の基礎力となります。</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド8: 【今日のポイント】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">8. まとめ</span>3分で復習！要点ポイント</h2>\n        <div style=\"display: flex; flex-direction: column; gap: 18px; margin-top: 10px;\">\n          <div style=\"background:#eff6ff; border:2px solid #bfdbfe; padding:18px; border-radius:14px; display:flex; align-items:center; gap:18px;\">\n            <span style=\"font-size:2.5rem;\">1️⃣</span>\n            <span style=\"font-size:1.25rem;\"><b>人差し指は「F」と「J」！</b> 突起の感触を頼りにホームポジションへ戻る。</span>\n          </div>\n          <div style=\"background:#eff6ff; border:2px solid #bfdbfe; padding:18px; border-radius:14px; display:flex; align-items:center; gap:18px;\">\n            <span style=\"font-size:2.5rem;\">2️⃣</span>\n            <span style=\"font-size:1.25rem;\"><b>手元は見ずに画面を見る！</b> 間違えてもOK。画面を見て打つ癖をつける。</span>\n          </div>\n          <div style=\"background:#eff6ff; border:2px solid #bfdbfe; padding:18px; border-radius:14px; display:flex; align-items:center; gap:18px;\">\n            <span style=\"font-size:2.5rem;\">3️⃣</span>\n            <span style=\"font-size:1.25rem;\"><b>毎日少しずつの継続！</b> タイピングは指の運動。練習した分だけ必ず速くなる！</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド9: 【理解度チェック（複数クイズ化）】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">9. クイズ</span>理解度確認クイズ（全3問）</h2>\n        \n        <div class=\"quiz-card\">\n          <div class=\"quiz-header\">\n            <span id=\"quizProgress\">第 1 問 / 全 3 問</span>\n            <span id=\"quizScore\">スコア: 0 点</span>\n          </div>\n          <div id=\"quizQuestion\" class=\"quiz-question\">\n            <!-- JSで問題文が注入されます -->\n          </div>\n          <div id=\"quizOptions\" class=\"quiz-options\">\n            <!-- JSで選択肢ボタンが注入されます -->\n          </div>\n          <div id=\"quizFeedback\" class=\"quiz-feedback\"></div>\n          \n          <button id=\"quizNextBtn\" class=\"btn btn-accent quiz-next-btn\" onclick=\"nextQuiz()\">次の問題へ ▶</button>\n        </div>\n      </div>\n\n      <!-- スライド10: 【今後の展望】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">10. 今後の展望</span>これからの課題と可能性</h2>\n        <div class=\"content-grid\">\n          <div class=\"card\">\n            <div class=\"card-icon\">🤖</div>\n            <h3>AI時代の情報発信</h3>\n            <p>AIを活用するときも、プロンプト（指示文）を素早く入力できる人がアイデアを素早く形にできます。</p>\n          </div>\n          <div class=\"card\">\n            <div class=\"card-icon\">🚀</div>\n            <h3>タイピング速度の目標設定</h3>\n            <p>1分間に100文字→200文字と目標を上げていくことで、パソコンを使った学習や表現の自由度が広がります！</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- スライド11: 【実践・寿司打対決】 -->\n      <div class=\"slide\">\n        <h2 class=\"slide-title\"><span class=\"badge\">11. 実践</span>寿司打クラス対決！🍣</h2>\n        <div class=\"sushida-box\">\n          <div class=\"target-badge\">🎯 対決コース：ふつう【お手軽 3,000円コース】</div>\n          \n          <div style=\"background: white; border-radius: 16px; padding: 20px; margin: 15px 0; border: 3px dashed #f59e0b;\">\n            <h3 style=\"color: var(--primary-dark); font-size: 1.4rem; margin-bottom: 8px;\">📊 中1の平均目標（お得金額）</h3>\n            <p style=\"font-size: 1.3rem; color: #1e293b; font-weight: bold;\">\n              中学1年生の目標目安：<span style=\"color: #dc2626; font-size: 1.5rem;\">「＋1,000円 〜 ＋1,500円 お得」</span><br>\n              <span style=\"font-size: 1.1rem; font-weight: normal; color: #475569;\">（＝ 合計4,000円〜4,500円分の皿をゲットできれば合格ライン！）</span>\n            </p>\n          </div>\n\n          <p style=\"font-size: 1.15rem; color: var(--text-muted); margin-bottom: 15px;\">\n            準備ができたら下の大きなボタンを押して「寿司打」を開始してください！<br>\n            ※授業用に音が鳴らないモードで開きます。\n          </p>\n\n          <!-- 寿司打へのリンク -->\n          <a href=\"https://sushida.net/play.html?soundless\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"sushida-link-btn\">\n            🍣 寿司打スタート（外部サイト）\n          </a>\n        </div>\n      </div>\n\n      <!-- ナビゲーションコントロール（拡大ボタン） -->\n      <div class=\"controls\">\n        <button id=\"prevBtn\" class=\"btn\" onclick=\"changeSlide(-1)\">◀ 前へ</button>\n        \n        <div class=\"progress-bar-container\">\n          <div id=\"progressBar\" class=\"progress-bar\"></div>\n        </div>\n        \n        <span id=\"slideCounter\" class=\"slide-counter\">1 / 11</span>\n        \n        <button id=\"nextBtn\" class=\"btn btn-accent\" onclick=\"changeSlide(1)\">次へ ▶</button>\n      </div>\n\n    </div>\n  </main>\n\n  <!-- 著作権表示 (右下に固定表示: fixed) -->\n  <footer class=\"copyright\">\n    ©2026 t-suzuki\n  </footer>\n\n  <!-- JS処理 -->\n  <script>\n    /* ==========================================================================\n       1. スライド切り替え機能\n       ========================================================================== */\n    let currentSlide = 0;\n    const slides = document.querySelectorAll('.slide');\n    const totalSlides = slides.length;\n    const prevBtn = document.getElementById('prevBtn');\n    const nextBtn = document.getElementById('nextBtn');\n    const progressBar = document.getElementById('progressBar');\n    const slideCounter = document.getElementById('slideCounter');\n\n    function showSlide(index) {\n      if (index < 0) index = 0;\n      if (index >= totalSlides) index = totalSlides - 1;\n\n      currentSlide = index;\n\n      slides.forEach((slide, idx) => {\n        if (idx === currentSlide) {\n          slide.classList.add('active');\n        } else {\n          slide.classList.remove('active');\n        }\n      });\n\n      prevBtn.disabled = (currentSlide === 0);\n      if (currentSlide === totalSlides - 1) {\n        nextBtn.innerText = \"完了 🎉\";\n      } else {\n        nextBtn.innerText = \"次へ ▶\";\n      }\n\n      const progressPercent = ((currentSlide + 1) / totalSlides) * 100;\n      progressBar.style.width = `${progressPercent}%`;\n      slideCounter.innerText = `${currentSlide + 1} / ${totalSlides}`;\n    }\n\n    function changeSlide(direction) {\n      showSlide(currentSlide + direction);\n    }\n\n    /* ==========================================================================\n       2. 理解度チェック（複数問題対応インタラクティブクイズ機能）\n       ※教員が後から問題を追加・編集しやすい配列構造になっています。\n       ========================================================================== */\n    const quizData = [\n      {\n        question: \"問1：ホームポジションで、左右の人差し指を置く「突起（ぽっち）」がついているキーの組み合わせはどれ？\",\n        options: [\n          { text: \"A. A と L\", correct: false },\n          { text: \"B. F と J\", correct: true },\n          { text: \"C. S と K\", correct: false }\n        ],\n        explanation: \"正解は「B. F と J」です！突起の感触を頼りにすると手元を見ずに指を戻せます。\"\n      },\n      {\n        question: \"問2：キーボードを手元で見ずに、画面だけを見て文字を入力する技術を何と呼ぶ？\",\n        options: [\n          { text: \"A. ブラインドタッチ（タッチタイピング）\", correct: true },\n          { text: \"B. スピードタイピング\", correct: false },\n          { text: \"C. フリック入力\", correct: false }\n        ],\n        explanation: \"正解は「A. タッチタイピング」です！画面に集中することで作業スピードが圧倒的に上がります。\"\n      },\n      {\n        question: \"問3：正しいタイピングを身につけるための「一番のコツ」はどれ？\",\n        options: [\n          { text: \"A. とにかく1本の指だけで全力で速く打つ\", correct: false },\n          { text: \"B. ずっとキーボードの手元だけを見つめて打つ\", correct: false },\n          { text: \"C. 1文字打ったら、指をホームポジションに戻す\", correct: true }\n        ],\n        explanation: \"正解は「C. 1文字打ったらホームポジションに戻す」です！基本姿勢を守ることが上達への近道です。\"\n      }\n    ];\n\n    let currentQuizIndex = 0;\n    let score = 0;\n\n    function renderQuiz() {\n      const q = quizData[currentQuizIndex];\n      document.getElementById('quizProgress').innerText = `第 ${currentQuizIndex + 1} 問 / 全 ${quizData.length} 問`;\n      document.getElementById('quizScore').innerText = `スコア: ${score} 点`;\n      document.getElementById('quizQuestion').innerText = q.question;\n\n      const optionsContainer = document.getElementById('quizOptions');\n      optionsContainer.innerHTML = '';\n\n      q.options.forEach((opt) => {\n        const btn = document.createElement('button');\n        btn.className = 'quiz-option-btn';\n        btn.innerText = opt.text;\n        btn.onclick = () => answerQuiz(opt.correct, q.explanation);\n        optionsContainer.appendChild(btn);\n      });\n\n      // フィードバックと次へボタンをリセット\n      const feedback = document.getElementById('quizFeedback');\n      feedback.style.display = 'none';\n      document.getElementById('quizNextBtn').style.display = 'none';\n    }\n\n    function answerQuiz(isCorrect, explanation) {\n      const feedback = document.getElementById('quizFeedback');\n      const optionButtons = document.querySelectorAll('.quiz-option-btn');\n\n      // 回答後はボタンを無効化\n      optionButtons.forEach(btn => btn.disabled = true);\n\n      feedback.style.display = 'block';\n      if (isCorrect) {\n        score += 10;\n        feedback.className = 'quiz-feedback correct';\n        feedback.innerHTML = `⭕ 正解！<br>${explanation}`;\n      } else {\n        feedback.className = 'quiz-feedback incorrect';\n        feedback.innerHTML = `❌ 残念！<br>${explanation}`;\n      }\n\n      document.getElementById('quizScore').innerText = `スコア: ${score} 点`;\n\n      // 「次の問題へ」ボタンを表示\n      const nextBtn = document.getElementById('quizNextBtn');\n      if (currentQuizIndex < quizData.length - 1) {\n        nextBtn.innerText = \"次の問題へ ▶\";\n      } else {\n        nextBtn.innerText = \"結果を確認する 🎉\";\n      }\n      nextBtn.style.display = 'inline-block';\n    }\n\n    function nextQuiz() {\n      if (currentQuizIndex < quizData.length - 1) {\n        currentQuizIndex++;\n        renderQuiz();\n      } else {\n        // クイズ終了時の結果表示\n        document.getElementById('quizQuestion').innerText = \"🎉 クイズ完了！\";\n        document.getElementById('quizOptions').innerHTML = '';\n        document.getElementById('quizFeedback').className = 'quiz-feedback correct';\n        document.getElementById('quizFeedback').innerHTML = `お疲れ様でした！<br>あなたのスコアは <b>${score} / ${quizData.length * 10} 点</b> です！<br>学んだポイントを意識して最後の「寿司打」に挑戦しよう！`;\n        document.getElementById('quizNextBtn').style.display = 'none';\n      }\n    }\n\n    // キーボードの左右矢印キーでのスライド操作サポート\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight' || e.key === 'PageDown') {\n        changeSlide(1);\n      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {\n        changeSlide(-1);\n      }\n    });\n\n    // 初期化実行\n    showSlide(0);\n    renderQuiz();\n  </script>\n</body>\n</html>"
            }
          ]
        }
      ]
    },
    {
      "grade_name": "その他・ツール",
      "zones": [
        {
          "zone_number": "★",
          "zone_title": "全学年共通・便利学習ツール＆サイト集",
          "field": "共通・ガイダンス",
          "instruction": "タイピング練習やプログラミングエディタなど、授業でよく使う共通ツールまとめです。",
          "web_items": [
            {
              "kind": "学習サイト・アプリ",
              "title": "【サンプル】Scratch（スクラッチ）公式サイト",
              "url": "https://scratch.mit.edu/",
              "description": "ブロックプログラミングの制作画面を開きます。"
            }
